import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

# Leer el archivo
df = pd.read_csv("dataset_clientes-1.csv")

# Variables para el clustering
X = df[[
    "Compras_Mensuales",
    "Gasto_Mensual_MXN",
    "Dias_Desde_Ultima_Compra"
]]

# Eliminar nulos
X = X.dropna()

# Escalar datos
escalador = StandardScaler()
X_escalado = escalador.fit_transform(X)

# Modelo K-Means
modelo = KMeans(n_clusters=3, random_state=42, n_init=10)

# Entrenar
clusters = modelo.fit_predict(X_escalado)

# Agregar el clúster
df_limpio = X.copy()
df_limpio["Cluster"] = clusters

# Resultados
print(df_limpio)

print("\nPromedio por clúster:")
print(df_limpio.groupby("Cluster").mean())
#Interpretacion
print("Interpretacion: El algoritmo K-Means agrupó a los clientes en tres clústeres con características similares, considerando las variables compras mensuales, gasto mensual y días desde la última compra. Los resultados muestran que cada grupo presenta un comportamiento de compra diferente, lo que permite identificar segmentos de clientes para diseñar estrategias específicas de marketing, promociones y fidelización.")
